{
  "expo": {
    "name": "MarketingTool",
    "slug": "marketingtool",
    "owner": "aimarketintool-2-2-2-2",
    "version": "1.5.11",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "marketingtool",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.marketingtool.app",
      "buildNumber": "1001",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "FirebaseAppDelegateProxyEnabled": true,
        "GADApplicationIdentifier": "ca-app-pub-3940256099942544~1458002511",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.911925145433-f885hn108caqm828puujtqd46eimh6ps"
            ]
          }
        ],
        "NSCameraUsageDescription": "Allow MarketingTool to access your camera to upload your profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow MarketingTool to access your photos to upload a profile picture or share generated content.",
        "NSFaceIDUsageDescription": "Use Face ID to sign in securely.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized marketing content.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "mailto",
          "tel",
          "sms"
        ]
      },
      "associatedDomains": [
        "applinks:marketingtool.pro",
        "applinks:app.marketingtool.pro"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060b28"
      },
      "googleServicesFile": "./google-services.json",
      "package": "pro.marketingtool.app",
      "versionCode": 1002,
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "VIBRATE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4",
            "storeKitVersion": "2",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBMessaging",
              "RNFBAnalytics",
              "RNFBCrashlytics",
              "RNFBFirestore",
              "NitroIap"
            ],
            "extraPods": [
              {
                "name": "RecaptchaEnterprise",
                "version": "~> 18.0"
              }
            ],
            "extraCCFlags": [
              "-Wno-everything",
              "-Xfrontend -disable-implicit-concurrency-module-import"
            ]
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "windowSoftInputMode": "adjustResize",
            "useLegacyPackaging": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "ndkVersion": "27.1.12297006",
            "kotlinVersion": "2.3.0",
            "kspVersion": "2.3.0"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "@react-native-firebase/app-check",
      "@react-native-firebase/crashlytics",
      "./plugins/withEasPodfileFix.js",
      "./plugins/withIosFirebaseSwiftFix.js",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ],
      "./plugins/withAndroid15EdgeToEdge.js",
      "./plugins/withRNEdgeToEdgeFix.js",
      "./plugins/withFirebaseDeferredInit.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#060b28"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-web-browser",
      "expo-asset",
      "expo-tracking-transparency",
      "./plugins/withKotlinKspFix.js",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2789940907288323~8551339904",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-dev-launcher",
      "expo-updates"
    ],
    "extra": {
      "appwriteEndpoint": "https://api.marketingtool.pro/v1",
      "appwriteProjectId": "6952c8a0002d3365625d",
      "aiApiUrl": "https://app.marketingtool.pro",
      "firebase": {
        "reCaptchaAndroid": "6LfbGWIsAAAAANFrzk-amOvKmohN6JCkft-uJXsR",
        "reCaptchaIos": "6LegEWIsAAAAAOgbGP08ISyfgJWExxSRV9iLuanX"
      },
      "eas": {
        "projectId": "e7abf1ac-3cab-4cfb-9cb2-f55c1783dd7e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/e7abf1ac-3cab-4cfb-9cb2-f55c1783dd7e"
    }
  }
}
