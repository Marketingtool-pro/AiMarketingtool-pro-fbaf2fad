    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.marketingtool.app",
      "buildNumber": "535",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "FirebaseAppDelegateProxyEnabled": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.911925145433-f885hn108caqm828puujtqd46eimh6ps"
            ]
          }
        ],
        "NSCameraUsageDescription": "Allow MarketingTool to access your camera to upload your profile photo.",
