{
  "expo": {
    "name": "MarketingTool",
    "slug": "marketingtool",
    "version": "1.5.0",
    "orientation": "default",
    "icon": "./assets/icon.webp",
    "userInterfaceStyle": "dark",
    "scheme": "marketingtool",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/icon.webp",
      "resizeMode": "contain",
      "backgroundColor": "#060b28"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.marketingtool.app",
      "buildNumber": "479",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "FirebaseAppDelegateProxyEnabled": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.911925145433-f885hn108caqm828puujtqd46eimh6ps"
            ]
          }
        ],
        "NSCameraUsageDescription": "Allow MarketingTool to access your camera to upload your profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow MarketingTool to access your photos to upload a profile picture or share generated content.",
        "NSFaceIDUsageDescription": "Use Face ID to sign in securely.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized marketing content.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "mailto",
          "tel",
          "sms"
        ]
      },
      "associatedDomains": [
        "applinks:marketingtool.pro",
        "applinks:app.marketingtool.pro"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.webp",
        "backgroundColor": "#060b28"
      },
      "googleServicesFile": "./google-services.json",
      "package": "pro.marketingtool.app",
      "versionCode": 474,
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "marketingtool.pro",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "app.marketingtool.pro",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.webp",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.0",
            "storeKitVersion": "2",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBMessaging",
              "RNFBAnalytics",
              "RNFBCrashlytics",
              "RNFBFirestore",
              "RNIap"
            ],
            "extraPods": [
              {
                "name": "RecaptchaEnterprise",
                "version": "~> 18.0"
              }
            ],
            "extraCCFlags": [
              "-Wno-everything",
              "-Xfrontend -disable-implicit-concurrency-module-import"
            ]
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24,
            "windowSoftInputMode": "adjustResize",
            "useMemoryPageSize16KB": true,
            "ndkVersion": "27.1.12297006",
            "kotlinVersion": "2.1.20",
            "kspVersion": "2.1.20-1.0.32",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResources": true
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "@react-native-firebase/app-check",
      "@react-native-firebase/crashlytics",
      "./plugins/withEasPodfileFix.js",
      "./plugins/withIosFirebaseSwiftFix.js",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ],
      "./plugins/withAndroid15EdgeToEdge.js",
      "./plugins/withFirebaseDeferredInit.js",
      "expo-notifications",
      "react-native-iap",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-web-browser",
      "expo-asset",
      "./plugins/withKotlinKspFix.js"
    ],
    "extra": {
      "appwriteEndpoint": "https://api.marketingtool.pro/v1",
      "appwriteProjectId": "6952c8a0002d3365625d",
      "aiApiUrl": "https://app.marketingtool.pro",
      "firebase": {
        "reCaptchaAndroid": "6LfbGWIsAAAAANFrzk-amOvKmohN6JCkft-uJXsR",
        "reCaptchaIos": "6LegEWIsAAAAAOgbGP08ISyfgJWExxSRV9iLuanX"
      },
      "eas": {
        "projectId": "93b0a546-bd05-4250-b2c9-58aa43ecc1f2"
      }
    },
    "owner": "aimarketintool-2-2-2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/93b0a546-bd05-4250-b2c9-58aa43ecc1f2"
    }
  }
}
