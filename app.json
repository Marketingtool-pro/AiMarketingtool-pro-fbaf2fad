{
  "expo": {
    "name": "Marketing AI",
    "slug": "marketingtool",
    "version": "1.3.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "marketingtool",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F1C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.marketingtool.app",
      "buildNumber": "74",
      "googleServicesFile": "GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow MarketingTool to access your camera for profile photos and content creation.",
        "NSPhotoLibraryUsageDescription": "Allow MarketingTool to access your photos for uploading media content.",
        "NSMicrophoneUsageDescription": "Allow MarketingTool to access your microphone for voice features.",
        "NSFaceIDUsageDescription": "Allow MarketingTool to use Face ID for secure authentication.",
        "NSLocationWhenInUseUsageDescription": "Allow MarketingTool to access your location for personalized content.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads and analytics.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "mailto",
          "tel",
          "sms"
        ]
      },
      "associatedDomains": [
        "applinks:marketingtool.pro",
        "applinks:app.marketingtool.pro"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F1C"
      },
      "googleServicesFile": "google-services.json",
      "package": "pro.marketingtool.app",
      "versionCode": 44,
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "marketingtool.pro",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "app.marketingtool.pro",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.0",
            "extraCCFlags": [
              "-Wno-error=implicit-function-declaration",
              "-Wno-error=implicit-int",
              "-Wno-redeclared-class-member",
              "-Wno-non-modular-include-in-framework-module",
              "-Wno-error=non-modular-include-in-framework-module"
            ]
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "windowSoftInputMode": "adjustResize"
          }
        }
      ],
      "./plugins/withEasPodfileFix.js",
      "./plugins/withEdgeToEdgeFix.js",
      [
        "tamagui",
        {
          "config": "./tamagui.config.ts",
          "components": ["tamagui"]
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-web-browser",
      "expo-asset"
    ],
    "extra": {
      "appwriteEndpoint": "https://api.marketingtool.pro/v1",
      "appwriteProjectId": "6952c8a0002d3365625d",
      "aiApiUrl": "https://app.marketingtool.pro",
      "eas": {
        "projectId": "93b0a546-bd05-4250-b2c9-58aa43ecc1f2"
      }
    },
    "owner": "aimarketintool-2-2-2"
  }
}
