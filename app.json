{
  "expo": {
    "name": "Marketing AI",
    "slug": "marketingtool",
    "version": "1.3.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "marketingtool",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F1C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.marketingtool.app",
      "buildNumber": "130",
      "googleServicesFile": "GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F1C"
      },
      "googleServicesFile": "google-services.json",
      "package": "pro.marketingtool.app",
      "versionCode": 130
    },
    "plugins": [
      "./plugins/withEasPodfileFix.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-web-browser",
      "expo-asset"
    ],
    "extra": {
      "appwriteEndpoint": "https://api.marketingtool.pro/v1",
      "appwriteProjectId": "6952c8a0002d3365625d",
      "aiApiUrl": "https://app.marketingtool.pro",
      "eas": {
        "projectId": "93b0a546-bd05-4250-b2c9-58aa43ecc1f2"
      }
    },
    "owner": "aimarketintool-2-2-2"
  }
}
