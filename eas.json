{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.18.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "IS_TESTING": "true",
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "channel": "development"
    },
    "development-ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "development-ios-simulator"
    },
    "preview": {
      "distribution": "internal",
      "node": "24.18.0",
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      },
      "env": {
        "IS_TESTING": "true",
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "node": "24.18.0",
      "android": {
        "resourceClass": "medium"
      },
      "env": {
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./AuthKey_69JDXUCPU3.p8",
        "ascApiKeyId": "69JDXUCPU3",
        "ascApiKeyIssuerId": "$ASC_API_KEY_ISSUER_ID",
        "ascAppId": "6758618412"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
