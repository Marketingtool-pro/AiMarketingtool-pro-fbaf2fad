{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.14.0",
      "ios": {
        "image": "sdk-55"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.14.0",
      "ios": {
        "image": "sdk-55"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.14.0",
      "ios": {
        "image": "macos-sequoia-15.3-xcode-16.2"
      },
      "env": {
        "EXPO_DOCTOR_SKIP_DEPENDENCY_VALIDATION_CHECK": "1",
        "EXPO_DOCTOR_ENABLE_DUPLICATE_DEPENDENCY_CHECK": "0",
        "EAS_BUILD_SKIP_DOCTOR": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6758618412",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyIssuerId": "313ffa8d-5aed-4aad-a012-b1057717634c",
        "ascApiKeyId": "D5KG7J5R95"
      }
    }
  }
}
