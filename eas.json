{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "simulator": {
      "channel": "production",
      "environment": "production",
      "ios": {
        "simulator": true
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "resourceClass": "large",
      "android": {
        "resourceClass": "large"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6758618412",
        "appleId": "help@marketingtool.pro"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
