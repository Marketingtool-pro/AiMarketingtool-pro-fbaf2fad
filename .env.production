# Production Environment Variables
# Copy this to .env and fill in your values before deploying

# App Configuration
APP_DOMAIN=api.marketingtool.pro
ENVIRONMENT=production

# Database
DB_USER=appwrite
DB_PASSWORD=your_secure_db_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here

# Redis Cache
REDIS_PASSWORD=your_secure_redis_password_here

# Appwrite
OPENSSL_KEY=your_openssl_key_here
_APP_ENV=production

# Email Configuration (for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_FROM=noreply@marketingtool.pro
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# App Configuration
APPWRITE_ENDPOINT=https://api.marketingtool.pro/v1
APPWRITE_PROJECT_ID=6952c8a0002d3365625d

# Apple/iOS Deployment
APPLE_APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id
APPLE_TEAM_NAME=your_team_name

# Android Deployment
ANDROID_KEYSTORE_PASSWORD=your_keystore_password
ANDROID_KEY_PASSWORD=your_key_password
