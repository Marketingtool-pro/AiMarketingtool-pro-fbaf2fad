@marketingtool-pro:registry=https://npm.pkg.github.com

# An auth-token line used to sit here interpolating the GITHUB_TOKEN env var.
# yarn 1.x expands .npmrc variables eagerly and aborts when one is unset, so
# every EAS build failed before installing anything, with:
#   error Failed to replace env in config
# Nothing in package.json resolves from the @marketingtool-pro scope -- that is
# this package's own publish target -- so install needs no credentials at all.
# The publish workflow writes its own ~/.npmrc, so publishing is unaffected.
# If a private scoped dependency is ever added, supply the token at build time
# (an EAS secret that writes ~/.npmrc), never from this tracked file.

legacy-peer-deps=true
