# 1. Ignore large directories
node_modules/
ios/
android/
dist/
.expo/
.git/
gemini-cli/
my-app/
conductor/
credentials/
__pycache__/

# 2. Specifically exclude the massive image folders
src/assets/images/tool-icons/
src/assets/images/tool-icons-v2/

# 3. Allow all necessary config and source files
!package.json
!package-lock.json
!app.json
!eas.json
!App.tsx
!index.ts
!tsconfig.json
!babel.config.js
!metro.config.js
!.env*
!GoogleService-Info.plist
!google-services.json

# 4. CRITICAL: Allow all plugins
!plugins/**

# 5. Allow source and assets
!src/**
!assets/**
