# Dependencies
node_modules/

# Native folders (EAS generates these)
ios/
android/

# Build artifacts
dist/
build/
web-build/

# Expo / Debug
.expo/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Secrets & Credentials (EAS uses its own)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# IDE / System
.vscode/
.idea/
.DS_Store
**/.git/

# Massive asset folders (EAS might struggle with these if too large)
# /src/assets/images/tool-icons/

# Ensure plugins and src are ALWAYS included
!plugins/
!src/
!assets/
