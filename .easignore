# Files excluded from the EAS build upload.
# Works like .gitignore but only for EAS; the repo keeps these files.

# Local GitHub Packages auth. It contains ${GITHUB_TOKEN}, which does not
# exist in the EAS build container, so yarn aborts before installing anything:
#   error Failed to replace env in config: ${GITHUB_TOKEN}
# No @marketingtool-pro package is an actual dependency, so the build has no
# need for a private registry at all.
.npmrc
**/.npmrc

# Other package managers' lockfiles — EAS must resolve with yarn only.
bun.lock
bun.lockb
package-lock.json
pnpm-lock.yaml

# Vendored projects that are not part of the app. These add gigabytes to the
# upload and pull unrelated manifests into dependency scanning.
m3/
jsonschex/
bundletool-1.18.3/
terraform-provider-exampletime/
circleci-runner/
travis-build/
gh-cli/
zsh-build/
conductor/
externals/
MyMacro/
my-env-plugin/
erl_crash.dump

# Build/debug leftovers
*.log
build-logs.md
profile-out/
dist/
