# 1. Block everything
/*

# 2. Allow only core config
!/package.json
!/package-lock.json
!/app.json
!/eas.json
!/App.tsx
!/index.ts
!/tsconfig.json
!/babel.config.js
!/metro.config.js
!/.env*
!/GoogleService-Info.plist
!/google-services.json

# 3. Allow only essential folders
!/src/
!/assets/
!/plugins/

# 4. CRITICAL: Block heavy items inside those folders
/src/assets/images/tool-icons/
/src/assets/images/tool-icons-v2/
/dist/
/ios/
/android/
/node_modules/
**/.expo/
**/.git/
**/.DS_Store
