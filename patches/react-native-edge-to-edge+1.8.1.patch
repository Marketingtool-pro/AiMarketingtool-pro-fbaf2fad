+  // -- Play Console: deprecated edge-to-edge APIs ------------------------------
+  // Play flags STATIC bytecode references to Window.setStatusBarColor /
+  // Window.setNavigationBarColor, so a `VERSION.SDK_INT < 35` runtime guard does
+  // NOT clear the warning: the invokevirtual is still in the DEX and still shows
+  // up as EdgeToEdgeModuleImpl.applyEdgeToEdge$lambda$4. Going through
+  // reflection removes the reference from the bytecode while preserving the
+  // behaviour on API < 35, where these setters remain the only way to get
+  // transparent system bars. On API >= 35 the call is skipped entirely --
+  // setDecorFitsSystemWindows(false) already yields transparent bars there.
+  //
+  // android.view.Window is a framework class and is never obfuscated, so the
+  // reflective lookup is stable under R8 full mode.
+  private fun setSystemBarColorCompat(window: Window, setter: String, color: Int) {
+    if (VERSION.SDK_INT >= 35) {
+      return
+    }
+    try {
+      Window::class.java
+        .getMethod(setter, Int::class.javaPrimitiveType)
+        .invoke(window, color)
+    } catch (error: Exception) {
+      FLog.w(ReactConstants.TAG, "$NAME: could not apply $setter: ${error.message}")
+    }
+  }
