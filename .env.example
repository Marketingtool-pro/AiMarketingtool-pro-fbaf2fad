# MarketingTool App Environment Variables
# Copy this file to .env and fill in your values

# Appwrite Configuration (already in app.json)
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://api.marketingtool.pro/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=6952c8a0002d3365625d

# AI backend endpoint
# Do not place provider secrets in EXPO_PUBLIC_* variables.
# Keep OpenAI / Anthropic / other provider API keys on the backend only.
EXPO_PUBLIC_AI_API_URL=https://api.marketingtool.pro/api/generate

# App Store / Play Store reviewer bypass
# Never hardcode reviewer credentials in source control.
# Configure reviewer-only values through secure environment or EAS secrets.
REVIEWER_PHONE=
REVIEWER_OTP=
# Salted PBKDF2 key(s) of the reviewer password for the demo@marketingtool.pro
# email bypass, "<salt hex>:<key hex>", comma-separated. EXPO_PUBLIC_* values ship
# inside the app, so store the key, never the password. Generate one with:
#   node scripts/reviewer-hash.mjs
# The password itself goes only in the App Store Connect / Play Console review notes.
EXPO_PUBLIC_REVIEWER_PASSWORD_PBKDF2=
