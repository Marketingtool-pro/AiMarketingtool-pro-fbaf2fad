{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "App.tsx"
  ],
  "exclude": [
    "node_modules",
    "functions",
    "appwrite-functions",
    "index.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
