FROM cimg/openjdk:26.0.1

RUN curl -fsSL https://archive.apache.org/dist/maven/maven-3/3.9.6/binaries/apache-maven-3.9.6-bin.tar.gz | sudo tar -xz -C /opt && sudo ln -s /opt/apache-maven-3.9.6/bin/mvn /usr/local/bin/mvn

WORKDIR /app
COPY --chown=circleci:circleci . .

RUN mvn install -DskipTests

RUN useradd -U -u 1000 appuser && chown -R 1000:1000 /app
USER 1000

CMD mvn test
