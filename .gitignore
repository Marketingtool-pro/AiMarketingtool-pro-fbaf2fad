# ── Claude Code plugin: marketingtool-rn-mcp ──────────────────────────────
# These negations must stay at the END of this file so they win as the
# last-matching .gitignore rule over the broad `*.json` (line 21) and
# `node_modules/` (line 2) guards above. The plugin's MCP server is vendored
# offline, so its node_modules is intentionally committed.
!.claude-plugin/marketplace.json
!plugin-rn-mcp/.claude-plugin/plugin.json
!plugin-rn-mcp/.mcp.json
!plugin-rn-mcp/server/node_modules/
!plugin-rn-mcp/server/node_modules/**

# Stray Android Compose codelab clone — not part of this app
codelab-android-compose/

# Local-only Ruby/fastlane tooling — keep out of the EAS build archive
# (EAS fails "inconsistent filename casing" on vendored gems: yaml/YAML).
vendor/
.bundle/
fastlane/
gradle-user-home/
gradle-user-home/

# Large local git bundles / backups — NEVER commit (backup.bundle is ~3.6 GB)
backup.bundle
mybundle
*.bundle


