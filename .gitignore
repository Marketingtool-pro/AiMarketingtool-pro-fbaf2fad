# The root lockfile is package-lock.json — yarn is not used here (dropped from
# mise.toml in ede9e6974; CI and CLAUDE.md both use npm/bun). EAS picks its
# package manager from whichever lockfile is present, so keeping a stray
# yarn.lock made EAS build with yarn while everything else used npm.
#
# package-lock.json is not caught by ~/.gitignore_global's "*.lock" rule, so it
# needs no negation. The old "!yarn.lock" line existed only to defeat that rule.

# --- self-hosted GitHub Actions runner install (never commit) ---
# A runner was once unpacked into the repo root and committed: config.sh,
# run, run.sh, run-helper.sh, run-helper.*.template, safe_sleep.sh, .path,
# plus a 69 MB circleci-runner binary and swiftly.pkg. Those are gone now;
# these rules stop them coming back.
/actions-runner/
/config.sh
/run
/run.sh
/run-helper.sh
/run-helper.cmd
/run-helper.cmd.template
/run-helper.sh.template
/safe_sleep.sh
/update.sh
/env.sh
/svc.sh
/.path
/.runner
/.credentials
/.credentials_rsaparams
/.setup_info
/.service
/bin/
/externals/
/_diag/
/_work/
/circleci-runner
/swiftly.pkg

# editor / shell junk that also got committed at the repo root
*.swp
.*.swp
.fl[A-F0-9]*
