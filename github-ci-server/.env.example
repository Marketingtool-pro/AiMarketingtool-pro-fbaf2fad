# Copy to .env and fill in values from your GitHub App registration
# (https://github.com/settings/apps -> your app).

# App ID shown on the app's settings page
GITHUB_APP_IDENTIFIER="YOUR_APP_ID"

# The webhook secret you set when registering the app
GITHUB_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Contents of the downloaded .pem private key.
# Keep it on one line with literal \n between the original lines.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Used as the committer identity for the "Fix this" auto-correct commits
GITHUB_APP_USER_NAME="APP_NAME[bot]"
GITHUB_APP_USER_EMAIL="APP_ID+APP_NAME[bot]@users.noreply.github.com"
