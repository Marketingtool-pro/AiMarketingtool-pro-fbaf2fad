# Keep npm's default peer handling here. Without this file, Dependabot falls
# back to the root .npmrc (legacy-peer-deps=true) when it relocks /functions,
# so it drops the jest peer tree that firebase-functions-test requires. CI
# runs `npm ci` with the default (peers installed), and the trimmed lockfile
# then fails with EUSAGE "Missing: jest@... from lock file".
legacy-peer-deps=false
