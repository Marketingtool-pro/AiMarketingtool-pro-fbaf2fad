    "firebase-functions": "^7.4.0",
    "genkit": "^1.42.0",
    "react": "19.3.1",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
