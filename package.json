    "ship:android": "npx expo-doctor && eas build --platform android --profile production --auto-submit --non-interactive"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-iap"
        ]
      }
    }
  },
